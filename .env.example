# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server Port (default 3000)
PORT=3000

# Secure Admin Access Code (Default: 1710 for local development, change in production)
ADMIN_ACCESS_CODE="1710"

# Exclusive Channels Access Password (Default: 2703, validated on server)
CHANNELS_ACCESS_PASSWORD="2703"

# Node Environment
NODE_ENV="development"

# Firebase Firestore Configuration (Optional on Render if firebase-applet-config.json is present)
# FIREBASE_PROJECT_ID="directed-curve-464213-q0"
# FIREBASE_API_KEY="AIzaSyCXyC-..."
# FIREBASE_AUTH_DOMAIN="directed-curve-464213-q0.firebaseapp.com"
# FIREBASE_DATABASE_ID="ai-studio-nexusgamingbundl-66daf3ab-d4fd-4301-8025-56c63010828d"

# GitHub Permanent Cloud Media Storage (Can also be configured in Admin Settings UI)
# GITHUB_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxx"
# GITHUB_REPO="yourusername/gamersplanet-media"
# GITHUB_BRANCH="main"
